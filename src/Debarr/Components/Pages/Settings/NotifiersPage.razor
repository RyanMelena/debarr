@page "/settings/notifiers"
@inherits LiveComponentBase

<PageTitle>Notifiers Settings - Debarr</PageTitle>

<PageHeader Title="Notifiers" />

@if (_notifiers is { Count: 0 })
{
    <MudText id="notifiers-empty" Class="mb-4">
        A notifier carries the ratio to your automation each time a player starts playback, over MQTT or a webhook.
        Add one to start.
    </MudText>
}

@if (_notifiers is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudGrid>
        @foreach (var notifier in _notifiers)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <CardButton Class="notifier-card" OnClick="@(() => EditAsync(notifier))">
                    <div class="d-flex align-center gap-2">
                        <MudText Typo="Typo.h6">@notifier.Name</MudText>
                        <MudChip T="string" Class="ms-auto" Size="Size.Small" Variant="Variant.Text"
                                 Color="@(notifier.Enabled ? Color.Success : Color.Default)"
                                 Icon="@(notifier.Enabled ? Icons.Material.Outlined.Check : Icons.Material.Outlined.PauseCircle)">@(notifier.Enabled ? "Enabled" : "Disabled")</MudChip>
                    </div>
                    @switch (notifier.Settings)
                    {
                        case MqttSettings mqtt:
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">MQTT</MudText>
                            <MudText Typo="Typo.body2" Class="mt-1"><PathText Value="@mqtt.Broker.ToUrl()" /></MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@mqtt.TopicTemplate</MudText>
                            break;
                        case WebhookSettings webhook:
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Webhook</MudText>
                            <MudText Typo="Typo.body2" Class="mt-1">@webhook.Method.ToHttpMethod() <PathText Value="@webhook.Url.OriginalString" /></MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@HeadersText(webhook)</MudText>
                            break;
                    }
                    <div class="notifier-card-delivery mud-typography-body2 mt-2">
                        @if (_lastDeliveries.GetValueOrDefault(notifier.Id) is { } delivery)
                        {
                            <span>Last delivery <DateTimeText Value="delivery.StartedAt" /> · </span><DeliveryOutcomeText Delivery="delivery" />
                        }
                        else
                        {
                            <span class="mud-text-secondary">No delivery yet</span>
                        }
                    </div>
                </CardButton>
            </MudItem>
        }

        <MudItem xs="12" sm="6" md="4" lg="3">
            <CardButton id="notifiers-add" Class="d-flex align-center justify-center" style="min-height: 7rem" aria-label="Add Notifier" OnClick="AddAsync">
                <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Large" />
            </CardButton>
        </MudItem>
    </MudGrid>
}
