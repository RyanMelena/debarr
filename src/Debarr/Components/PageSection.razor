<MudPaper Class="page-section pa-4" Outlined="true" @attributes="AdditionalAttributes">
    <div class="page-section-header">
        <MudText Typo="Typo.h6">@Title</MudText>
        @if (Actions is not null)
        {
            <div class="page-section-actions">@Actions</div>
        }
    </div>
    @if (Description is not null)
    {
        <div class="page-section-description">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Description</MudText>
        </div>
    }
    <div class="page-section-content">
        @ChildContent
    </div>
</MudPaper>
