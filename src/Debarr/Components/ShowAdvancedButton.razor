<MudButton Class="show-advanced" Variant="Variant.Text" Color="Color.Default"
           StartIcon="@(ShowAdvanced.Shown ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Tune)"
           aria-pressed="@(ShowAdvanced.Shown ? "true" : "false")" OnClick="ShowAdvanced.Toggle">@(ShowAdvanced.Shown ? "Hide Advanced" : "Show Advanced")</MudButton>
