<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet aria-labelledby="components-reconnect-title">
    <div class="components-reconnect-container">
        <div class="components-rejoining-animation" aria-hidden="true"></div>
        <h2 id="components-reconnect-title" class="components-reconnect-title">
            <span class="components-reconnect-first-attempt-visible">Reconnecting to Debarr</span>
            <span class="components-reconnect-repeated-attempt-visible components-reconnect-failed-visible">Debarr Is Not Answering</span>
            <span class="components-pause-visible">This Page Is Paused</span>
            <span class="components-resume-failed-visible">This Page Could Not Resume</span>
        </h2>
        <p class="components-reconnect-first-attempt-visible">
            This page lost its connection, and carries on where it left off once Debarr answers.
        </p>
        <p class="components-reconnect-repeated-attempt-visible">
            Trying again in <span id="components-seconds-to-next-attempt"></span> seconds.
        </p>
        <p class="components-reconnect-failed-visible">
            Debarr may have stopped or restarted. Retry once it is running, or reload the page.
        </p>
        <p class="components-pause-visible">
            Debarr paused this page while it was idle. Resume to carry on.
        </p>
        <p class="components-resume-failed-visible">
            Reload the page to carry on.
        </p>
        <div class="components-reconnect-actions">
            <button id="components-reload-button" type="button" class="components-reconnect-failed-visible components-resume-failed-visible components-reconnect-secondary">
                Reload
            </button>
            <button id="components-reconnect-button" type="button" class="components-reconnect-failed-visible">
                Retry
            </button>
            <button id="components-resume-button" type="button" class="components-pause-visible">
                Resume
            </button>
        </div>
    </div>
</dialog>
