<MudDialog>
    <DialogContent>
        <MudText id="confirm-message">@Message</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton id="confirm-cancel" OnClick="Cancel">Cancel</MudButton>
        <MudButton id="confirm-accept" Color="Color.Error" Variant="Variant.Filled" OnClick="Accept">@ConfirmText</MudButton>
    </DialogActions>
</MudDialog>
