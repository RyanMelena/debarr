[*.cs]
# Log through source-generated [LoggerMessage] methods with constant, PascalCase templates.
dotnet_diagnostic.CA1848.severity = error
dotnet_diagnostic.CA1727.severity = error
dotnet_diagnostic.CA2254.severity = error
# A namespace matches its folder, and a file's usings are all used.
dotnet_style_namespace_match_folder = true
dotnet_diagnostic.IDE0130.severity = error
dotnet_diagnostic.IDE0005.severity = error
# Every append states the version of the facts its decision read; BannedSymbols.txt lists the overloads that state none.
dotnet_diagnostic.RS0030.severity = error

[Debarr/Internal/Generated/**.cs]
generated_code = true
